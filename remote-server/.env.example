# ── PhotoLynk Remote Server configuration ──────────────────────────────
# Copy to .env or export in your systemd unit / shell. All values are
# optional — sensible self-hosted defaults are used when unset.

# Port the Node server listens on (keep 3000; nginx proxies 443 → 3000)
PORT=3000
HOST=0.0.0.0

# Where uploaded files are stored (per-device subfolders inside)
UPLOAD_DIR=

# SQLite database path
DB_PATH=

# Extra data dir (cloud manifests, EXIF, capacity JSON, uptime state).
# Defaults to the parent of UPLOAD_DIR.
PHOTOSYNC_DATA_DIR=

# JWT signing secret. Leave unset to auto-generate a unique per-install
# secret at ~/.config/photolynk/jwt-secret-<hash> (recommended).
# Set a long random value only if you need stable tokens across reinstalls.
# JWT_SECRET=

# Built-in TLS (optional — usually you terminate TLS at nginx/Caddy instead)
# ENABLE_HTTPS=false
# HTTPS_PORT=3443
# TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
# TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# FORCE_HTTPS_REDIRECT=false
