# ── PhotoLynk Remote Server configuration ──────────────────────────────
# Copy to .env or export in your systemd unit / shell. All values are
# optional — sensible self-hosted defaults are used when unset.

# Port the Node server listens on (keep 3000; nginx proxies 443 → 3000)
PORT=3000
# Listen address. 0.0.0.0 = reachable directly (needed for http://IP:3000
# remote mode). Set 127.0.0.1 if you only ever proxy through a local
# nginx/Caddy and want port 3000 firewalled off.
HOST=0.0.0.0

# Where uploaded files are stored (per-device subfolders inside)
UPLOAD_DIR=

# SQLite database path
DB_PATH=

# Extra data dir (cloud manifests, EXIF, capacity JSON, uptime state).
# Defaults to the parent of UPLOAD_DIR.
PHOTOSYNC_DATA_DIR=

# JWT signing secret. Leave unset to auto-generate a unique per-install
# secret at ~/.config/photolynk/jwt-secret-<hash> (recommended).
# Set a long random value only if you need stable tokens across reinstalls.
# JWT_SECRET=

# Reverse-proxy trust. 'loopback' (default) trusts X-Forwarded-For only from
# localhost — correct for the bundled nginx-on-same-host setup. Set to a
# number (hop count), 'true', or a proxy IP/CIDR if you front the server
# with a different proxy.
# TRUST_PROXY=

# Optional per-file upload cap in bytes (0 = unlimited). Stops one account
# from filling the VPS disk. The PhotoLynk app uploads whole files, so set
# this above your largest intended backup.
# UPLOAD_MAX_BYTES=

# Auth-endpoint rate limit (brute-force protection, per client IP).
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=25

# Built-in TLS (optional — usually you terminate TLS at nginx/Caddy instead)
# ENABLE_HTTPS=false
# HTTPS_PORT=3443
# TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
# TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# FORCE_HTTPS_REDIRECT=false
